# Golden case G10: Version boundary: the same package received 2026-01-01 (v2026.1 governs); December statement now required.
# SYNTHETIC. Hand-checked expectations: golden/expected.yaml. Derived values (ageAtReceiptDays,
# monthsBeforeReceipt) are written out here; check_consistency.py recomputes them from the dates.
# uc1:governingVersion is NOT stated: the runner evaluates each case under every guide version.

@prefix uc1:   <https://rag-os.example/uc1#> .
@prefix uc1tx: <https://rag-os.example/uc1/taxonomy#> .
@prefix app:   <https://rag-os.example/uc1/app#> .
@prefix ia:    <https://rag-os.example/uc1/investor-a#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

app:APP-1010
    a uc1:Application ;
    rdfs:label "APP-1010 (golden case G10)"@en ;
    uc1:loan app:L-1010 ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:hardshipReason uc1tx:IncomeReduction ;
    uc1:parties app:APP-1010-P1 ;
    uc1:documents app:APP-1010-D1, app:APP-1010-D2, app:APP-1010-D3, app:APP-1010-D4, app:APP-1010-D5, app:APP-1010-D6 .

app:L-1010 a uc1:Loan ; uc1:ownedBy ia:InvestorA ; uc1:lienPosition 1 ; uc1:propertyState "TX" .

app:APP-1010-P1
    a uc1:ApplicationParty ;
    uc1:borrower app:B1010 ;
    uc1:role uc1:PrimaryBorrower ;
    uc1:employmentType uc1tx:SelfEmployed ;
    uc1:hasRentalIncome false .
app:B1010 a uc1:Borrower .

app:APP-1010-D1
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:MAA ; uc1:confidence 1.0 ; uc1:classificationMethod "human" ; uc1:reviewedBy "reviewer-01" ] ;
    uc1:documentDate "2025-12-29T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 3 ;
    uc1:signature [ uc1:signed true ] .

app:APP-1010-D2
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:HardshipStatement ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-12-29T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 3 ;
    uc1:signature [ uc1:signed true ] .

app:APP-1010-D3
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:ProfitAndLoss ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-09-22T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 101 ;
    uc1:period [ uc1:startDate "2025-06-01T00:00:00"^^xsd:dateTime ; uc1:endDate "2025-08-31T00:00:00"^^xsd:dateTime ] ;
    uc1:monthsBeforeReceipt 5 ;
    uc1:signature [ uc1:signed false ] .

app:APP-1010-D4
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:BankStatement ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-11-30T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 32 ;
    uc1:period [ uc1:startDate "2025-11-01T00:00:00"^^xsd:dateTime ; uc1:endDate "2025-11-30T00:00:00"^^xsd:dateTime ] ;
    uc1:monthsBeforeReceipt 2 .

app:APP-1010-D5
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:BankStatement ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-10-31T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 62 ;
    uc1:period [ uc1:startDate "2025-10-01T00:00:00"^^xsd:dateTime ; uc1:endDate "2025-10-31T00:00:00"^^xsd:dateTime ] ;
    uc1:monthsBeforeReceipt 3 .

app:APP-1010-D6
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-01-01T10:00:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:Form4506C ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-12-29T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 3 ;
    uc1:signature [ uc1:signed true ] .
