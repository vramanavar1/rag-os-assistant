# Golden case G01: Worked example (UseCase1.html section 10): self-employed, rental income, unsigned 98-day-old P&L, one bank statement.
# SYNTHETIC. Hand-checked expectations: golden/expected.yaml. Derived values (ageAtReceiptDays,
# monthsBeforeReceipt) are written out here; check_consistency.py recomputes them from the dates.
# uc1:governingVersion is NOT stated: the runner evaluates each case under every guide version.

@prefix uc1:   <https://rag-os.example/uc1#> .
@prefix uc1tx: <https://rag-os.example/uc1/taxonomy#> .
@prefix app:   <https://rag-os.example/uc1/app#> .
@prefix ia:    <https://rag-os.example/uc1/investor-a#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

app:APP-1001
    a uc1:Application ;
    rdfs:label "APP-1001 (golden case G01)"@en ;
    uc1:loan app:L-1001 ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:hardshipReason uc1tx:IncomeReduction ;
    uc1:parties app:APP-1001-P1 ;
    uc1:documents app:APP-1001-D1, app:APP-1001-D2, app:APP-1001-D3, app:APP-1001-D4, app:APP-1001-D5, app:APP-1001-D6 .

app:L-1001 a uc1:Loan ; uc1:ownedBy ia:InvestorA ; uc1:lienPosition 1 ; uc1:propertyState "TX" .

app:APP-1001-P1
    a uc1:ApplicationParty ;
    uc1:borrower app:B1001 ;
    uc1:role uc1:PrimaryBorrower ;
    uc1:employmentType uc1tx:SelfEmployed ;
    uc1:hasRentalIncome true .
app:B1001 a uc1:Borrower .

app:APP-1001-D1
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:MAA ; uc1:confidence 1.0 ; uc1:classificationMethod "human" ; uc1:reviewedBy "reviewer-01" ] ;
    uc1:documentDate "2026-02-02T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 4 ;
    uc1:signature [ uc1:signed true ] .

app:APP-1001-D2
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:HardshipStatement ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2026-02-02T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 4 ;
    uc1:signature [ uc1:signed true ] .

app:APP-1001-D3
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:ProfitAndLoss ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-10-31T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 98 ;
    uc1:period [ uc1:startDate "2025-07-01T00:00:00"^^xsd:dateTime ; uc1:endDate "2025-09-30T00:00:00"^^xsd:dateTime ] ;
    uc1:monthsBeforeReceipt 5 ;
    uc1:signature [ uc1:signed false ] .

app:APP-1001-D4
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:BankStatement ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-12-31T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 37 ;
    uc1:period [ uc1:startDate "2025-12-01T00:00:00"^^xsd:dateTime ; uc1:endDate "2025-12-31T00:00:00"^^xsd:dateTime ] ;
    uc1:monthsBeforeReceipt 2 .

app:APP-1001-D5
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:Form4506C ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2026-02-02T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 4 ;
    uc1:signature [ uc1:signed true ] .

app:APP-1001-D6
    a uc1:SubmittedDocument ;
    uc1:receivedAt "2026-02-06T15:30:00"^^xsd:dateTime ;
    uc1:classification [ uc1:docType uc1tx:Lease ; uc1:confidence 0.93 ; uc1:classificationMethod "classifier" ] ;
    uc1:documentDate "2025-06-01T00:00:00"^^xsd:dateTime ;
    uc1:ageAtReceiptDays 250 ;
    uc1:signature [ uc1:signed true ] .
