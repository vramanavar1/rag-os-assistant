# Copy to .env for `uv run rag-os ...` / `uv run uvicorn ...` outside Docker. Every variable is documented in
# Deployment.md section 5 ("Application settings"). Secrets can be referenced as kv://<secret-name> when KEY_VAULT_URL is set.

APP_ENV=dev
LOG_LEVEL=INFO

# --- storage / state (local files + SQLite; use docker compose for PostgreSQL)
STATE_DB_URL=sqlite:///./.data/state.db
QUEUE=sql
SEARCH_BACKEND=local
RAW_STORE=filesystem
RAW_DIR=./.data/raw
CONFIG_STORE=filesystem
CONFIG_DIR=./config

# --- embeddings: self-hosted TEI (docker compose starts one on :8081)
EMBEDDING_PROFILE=qwen3-0.6b-1024
TEI_QUERY_URL=http://localhost:8081
TEI_INGEST_URL=http://localhost:8081

# --- text-generation models: fake (offline) | aoai | claude  (keyless via `az login` unless *_API_KEY is set)
# LLM_ANSWER  writes the cited answer.  LLM_UTILITY  rewrites follow-up questions and classifies facets.
# The *_UTILITY_* values are optional: unset means the utility role reuses the answer model.
LLM_ANSWER=fake
LLM_UTILITY=fake
AOAI_ENDPOINT=
# Required when EMBEDDING_PROFILE selects an azure_openai profile (e.g. aoai-3-small-1536).
AOAI_EMBED_DEPLOYMENT=
AOAI_CHAT_DEPLOYMENT=
AOAI_UTILITY_DEPLOYMENT=
CLAUDE_FOUNDRY_RESOURCE=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_UTILITY_MODEL=claude-haiku-4-5

# --- auth
DEV_AUTH_ENABLED=true
DEV_JWT_KEY=local-dev-key-change-me-0123456789abcdefghijkl
EMBED_ORIGINS=http://localhost:8080

# --- pointing a local CLI at Azure (e.g. `rag-os discover --source hr-share` from an admin machine):
# KEY_VAULT_URL=https://<kv>.vault.azure.net/
# STATE_DB_URL=postgresql+psycopg://<you@tenant>@<pg>.postgres.database.azure.com:5432/ragos?sslmode=require
# PG_ENTRA_AUTH=true
# QUEUE=servicebus
# SERVICEBUS_NAMESPACE=<ns>.servicebus.windows.net
# RAW_STORE=blob
# BLOB_ACCOUNT_URL=https://<st>.blob.core.windows.net
# CONFIG_STORE=blob
# SEARCH_BACKEND=azure
# SEARCH_ENDPOINT=https://<search>.search.windows.net
