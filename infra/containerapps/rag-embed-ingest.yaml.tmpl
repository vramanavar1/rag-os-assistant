# rag-embed-ingest - TEI ingestion embedding pool. INTERNAL only; scales to zero when idle.
# GPU mode:  turing image on the serverless T4 profile (gpu-t4), a full T4 per replica (8 vCPU / 56 GiB).
# Fallback:  cpu image on the 'ingest' profile (07 switches automatically when the GPU profile is unavailable).
location: "{{LOCATION}}"
name: rag-embed-ingest
type: Microsoft.App/containerApps
tags:
  {{TAGS}}
identity:
  type: UserAssigned
  userAssignedIdentities:
    "{{MI_ID}}": {}
properties:
  environmentId: "{{ENV_ID}}"
  workloadProfileName: {{EMBED_INGEST_PROFILE}}
  configuration:
    activeRevisionsMode: Single
    ingress:
      external: false
      targetPort: 80
      transport: http
      allowInsecure: true   # callers use http://rag-embed-ingest inside the environment
    registries:
      - server: "{{ACR_LOGIN_SERVER}}"
        identity: "{{MI_ID}}"
  template:
    containers:
      - name: tei
        image: "{{IMAGE_EMBED_INGEST}}"
        resources:
          cpu: {{EMBED_INGEST_CPU}}
          memory: {{EMBED_INGEST_MEMORY}}
        env:
          - name: MAX_BATCH_TOKENS
            value: "{{EMBED_INGEST_MAX_BATCH_TOKENS}}"
          # Bounds the warm-up, and with it the start-up memory. Unset, TEI uses the model's own maximum (32768
          # for Qwen3) and is OOM-killed on a 4Gi replica: attention memory is quadratic in sequence length.
          - name: MAX_INPUT_LENGTH
            value: "{{EMBEDDER_MAX_INPUT_TOKENS}}"
          - name: MAX_CLIENT_BATCH_SIZE
            value: "64"
          - name: RAYON_NUM_THREADS
            value: "{{EMBED_INGEST_THREADS}}"
          - name: TOKENIZATION_WORKERS
            value: "{{EMBED_INGEST_THREADS}}"
        probes:
          - type: Startup
            # This pool starts from zero on every idle period, so it pays a cold start on its first batch.
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 30
            periodSeconds: 20
            # Explicit: the default is 1s, which a cold replica loading a model will not answer within.
            timeoutSeconds: 10
            # 30 + 20 x 30 = 630s. The old ~4 minute budget was sized for the T4 image; with EnableGpu = $false
            # this same app runs the CPU image, where warming up a 0.6B model takes minutes on a few vCPU and the
            # replica was simply restarted forever. Sized for the slower of the two, because which one runs here
            # is a psd1 flag and a GPU quota decision, not something this file can see.
            failureThreshold: 30
          - type: Liveness
            httpGet:
              path: /health
              port: 80
            periodSeconds: 20
            timeoutSeconds: 10
            failureThreshold: 3
          - type: Readiness
            httpGet:
              path: /health
              port: 80
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
    scale:
      minReplicas: {{EMBED_INGEST_MIN_REPLICAS}}
      maxReplicas: {{EMBED_INGEST_MAX_REPLICAS}}
      rules:
        - name: http-concurrency
          http:
            metadata:
              concurrentRequests: "{{EMBED_INGEST_CONCURRENCY}}"
